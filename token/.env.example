# Voltix Wheel jetton — local env template
# Copy to token/.env.local and fill locally. Never commit .env.local.

# --- Testnet (deployed VTX) ---
VTX_DEPLOY_MNEMONIC=
VTX_JETTON_MASTER=
TONCENTER_API_KEY=

# Optional testnet aliases (ECU compatibility):
# WALLET_MNEMONIC=
# DEPLOY_MNEMONIC=

# --- Mainnet VLTX (NOT deployed yet — separate wallet required) ---
VLTX_MAINNET_DEPLOY_MNEMONIC=
VLTX_MAINNET_JETTON_MASTER=
TONCENTER_MAINNET_API_KEY=

# Required only for real mainnet transactions (never set casually):
VLTX_MAINNET_CONFIRM=
VLTX_REVOKE_ADMIN_CONFIRM=

# Mainnet confirmation values (set exactly when Yan approves each step):
# VLTX_MAINNET_CONFIRM=YES_I_UNDERSTAND
# VLTX_REVOKE_ADMIN_CONFIRM=YES_REVOKE_IRREVERSIBLY
